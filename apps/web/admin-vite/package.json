{
  "name": "admin-vite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --workspace-root node:runtime && tsc -b && vite build",
    "test": "vitest",
    "lint": "eslint ./src",
    "preview": "vite preview",
    "analyze": "vite-bundle-visualizer",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@ant-design/icons": "catalog:",
    "@library/hooks": "workspace:^",
    "@library/i18n": "workspace:^",
    "@library/react-components": "workspace:^",
    "@library/request": "workspace:^",
    "@module/model": "workspace:^",
    "@module/session-context": "workspace:^",
    "@module/session-sdk": "workspace:^",
    "@schema/auth": "workspace:^",
    "@schema/blog": "workspace:^",
    "@schema/rpc": "workspace:^",
    "antd": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@config/eslint": "workspace:^",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "catalog:",
    "browserslist-to-esbuild": "^2.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "sharp": "^0.35.5",
    "svgo": "^4.0.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0",
    "vite": "catalog:",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "catalog:"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 1 Safari versions"
  ]
}
