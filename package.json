{
  "name": "website",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare": "test -d node_modules/husky && husky",
    "typecheck:configs": "pnpm --filter '@config/*' --if-present typecheck",
    "typecheck:libraries": "pnpm --filter '@library/*' typecheck",
    "typecheck:modules": "pnpm --filter '@module/*' typecheck",
    "typecheck:server": "pnpm --filter './apps/server/*' typecheck",
    "build:web": "pnpm --filter './apps/web/*' build",
    "validate:pr": "pnpm typecheck:configs && pnpm typecheck:libraries && pnpm typecheck:modules && pnpm typecheck:server && pnpm build:web",
    "test": "pnpm --recursive --if-present test",
    "start": "docker compose pull && docker compose down && docker compose up -d",
    "stop": "docker compose down",
    "update": "docker compose pull && docker compose up -d"
  },
  "author": "Soulike",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "catalog:"
  },
  "prettier": {
    "singleQuote": true,
    "jsxSingleQuote": true,
    "bracketSpacing": false,
    "tabWidth": 2
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
