{
  "name": "website",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "node:sync": "pnpm --filter '@script/node-version' sync",
    "node:check": "pnpm --filter '@script/node-version' check",
    "node:runtime": "node scripts/node-version/src/check-runtime.ts",
    "workspace:check": "pnpm --filter '@script/workspace-check' check",
    "prepare": "test -d node_modules/husky && husky",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "build:server": "pnpm --filter './apps/server/*' build",
    "build:web": "pnpm --filter './apps/web/*' build",
    "validate:pr": "pnpm node:check && pnpm workspace:check && pnpm format:check && pnpm typecheck && pnpm lint && pnpm build:server && pnpm build:web",
    "test": "pnpm node:runtime && pnpm --recursive --if-present test",
    "start": "docker compose pull && docker compose down && docker compose up -d",
    "stop": "docker compose down",
    "update": "docker compose pull && docker compose up -d"
  },
  "author": "Soulike",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "catalog:"
  },
  "prettier": {
    "singleQuote": true,
    "jsxSingleQuote": true,
    "bracketSpacing": false,
    "tabWidth": 2
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
